# Gradium voice (speech-to-text and text-to-speech). Required for voice.
GRADIUM_API_KEY=
# Login with ChatGPT session encryption secret: openssl rand -hex 32
LWC_SECRET=
# Optional dev-only LLM fallback (any OpenAI-compatible endpoint) used when no ChatGPT session exists.
# Production ignores DEV_LLM_* and DEV_IMAGE_MODEL unless explicitly opted in below.
# Opt-in also permits voice tokens without a ChatGPT session. Keep disabled for the product.
ALLOW_DEV_LLM_IN_PRODUCTION=0
DEV_LLM_BASE_URL=
DEV_LLM_API_KEY=
DEV_LLM_MODEL=
DEV_IMAGE_MODEL=
API_PORT=8787
ALLOWED_ORIGINS=
