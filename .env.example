# Gradium voice (speech-to-text). Required for voice.
GRADIUM_API_KEY=
# Claude API key for the shared model (Claude Haiku 5.5 by default).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Model calls stop for the rest of the month once spend reaches this many dollars.
MONTHLY_BUDGET_USD=100
# Optional OpenAI-compatible endpoint for local development and tests. Ignored in production
# unless ALLOW_DEV_LLM_IN_PRODUCTION=1.
ALLOW_DEV_LLM_IN_PRODUCTION=0
DEV_LLM_BASE_URL=
DEV_LLM_API_KEY=
DEV_LLM_MODEL=
DEV_IMAGE_MODEL=
API_PORT=8787
ALLOWED_ORIGINS=
